{
  "manifest_version": 3,
  "name": "PokéSurvivor Vault Pro",
  "version": "3.0",
  "description": "Sistema profesional de respaldo cifrado SHA-256 y bóveda local para PokéSurvivor.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
